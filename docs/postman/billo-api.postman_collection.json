        {
          "name": "06 CP-RF1-02 [API] — Login válido y guardar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "let body = {}; try { body = pm.response.json(); } catch { /* La prueba Respuesta JSON registra el fallo. */ }",
                  "pm.test('Devuelve token y usuario registrado', function () {",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.token.split('.')).to.have.lengthOf(3);",
                  "  pm.expect(body.usuario.id).to.equal(Number(pm.variables.get('qaUserId')));",
                  "  pm.expect(body.usuario.nombre).to.equal(pm.variables.get('qaNombre'));",
                  "});",
                  "if (pm.response.code === 200 && typeof body.token === 'string' && body.token) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "  pm.variables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
