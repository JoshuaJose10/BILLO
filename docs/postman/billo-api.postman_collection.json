{
  "info": {
    "_postman_id": "c74bfb83-270b-40bd-a66c-397e7be63816",
    "name": "Billo API",
    "description": "QA RF1: ejecutar la colección completa en orden. Cada iteración registra una cuenta QA exclusiva en example.test. baseUrl=http://localhost:3000; no necesita ambiente ni datos manuales. El login guarda token automáticamente. Las aserciones CONTRATO detectan diferencias reales y no bloquean las siguientes peticiones. Revisar docs/postman/README.md. RF2–RF8 y pruebas de UI están en docs/checklist-pruebas.md. No contiene JWT ni credenciales reales exportadas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Respuesta JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  pm.expect(function () { pm.response.json(); }).not.to.throw();",
          "});",
          "pm.test('No expone contraseñas ni hashes', function () {",
          "  const body = pm.response.json();",
          "  const usuario = body.usuario || body;",
          "  pm.expect(usuario).not.to.have.property('password');",
          "  pm.expect(usuario).not.to.have.property('password_hash');",
          "});"
        ]
      }
    }
  ],
