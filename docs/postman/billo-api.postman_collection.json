  "item": [
    {
      "name": "01 Autenticación — ejecutar en orden",
      "item": [
        {
          "name": "01 CP-RF1-01 [API] — Registro válido e inicialización",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}').toLowerCase().replace(/-/g, '');",
                  "const values = {",
                  "  qaEmail: 'qa.postman.' + runId + '@example.test',",
                  "  qaOtherEmail: 'qa.inexistente.' + runId + '@example.test',",
                  "  qaPassword: 'Qa!' + runId,",
                  "  qaNombre: 'QA Postman', token: '', qaUserId: '', qaCredentialError: ''",
                  "};",
                  "Object.keys(values).forEach(function (key) {",
                  "  pm.collectionVariables.set(key, values[key]);",
                  "  pm.variables.set(key, values[key]);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "let body = {}; try { body = pm.response.json(); } catch { /* La prueba Respuesta JSON registra el fallo. */ }",
                  "// Capturar el ID permite continuar incluso si se detecta el defecto de envoltura.",
                  "const usuario = body.usuario || body;",
                  "pm.test('Usuario creado con los datos de QA', function () {",
                  "  pm.expect(usuario.id).to.be.a('number').and.above(0);",
                  "  pm.expect(usuario.nombre).to.equal(pm.variables.get('qaNombre'));",
                  "  pm.expect(usuario.email).to.equal(pm.variables.get('qaEmail'));",
                  "});",
                  "if (pm.response.code === 201 && usuario.id) {",
                  "  pm.collectionVariables.set('qaUserId', String(usuario.id));",
                  "  pm.variables.set('qaUserId', String(usuario.id));",
                  "}",
                  "pm.test('CONTRATO: registro devuelve { usuario: {...} }', function () {",
                  "  pm.expect(body).to.have.property('usuario').that.is.an('object');",
                  "  pm.expect(body.usuario).to.include.all.keys('id', 'nombre', 'email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{qaNombre}}\",\n  \"email\": \"{{qaEmail}}\",\n  \"password\": \"{{qaPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Cobertura API parcial de CP-RF1-01. Genera datos nuevos en cada ejecución/iteración. La navegación y el registro móvil se verifican en Android."
          },
          "response": []
        },
