              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
                  "let body = {}; try { body = pm.response.json(); } catch { /* La prueba Respuesta JSON registra el fallo. */ }",
                  "pm.test('Código funcional: NO_AUTORIZADO', function () {",
                  "  pm.expect(body.error).to.be.an('object');",
                  "  pm.expect(body.error.codigo || body.error.code).to.equal('NO_AUTORIZADO');",
                  "  pm.expect(body.error.mensaje || body.error.message).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('CONTRATO: error.codigo y error.mensaje', function () {",
                  "  pm.expect(body.error).to.include.all.keys('codigo', 'mensaje');",
                  "  pm.expect(body.error.codigo).to.equal('NO_AUTORIZADO');",
                  "  pm.expect(body.error.mensaje).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
