# Copia este archivo como .env y pon la IPv4 de tu PC (ipconfig) y el puerto del backend.
# El celular con Expo Go debe estar en la misma red WiFi.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# API en línea (HU-52): para probar sin depender de tu PC, usa esta URL (sin diagonal final).
# EXPO_PUBLIC_API_URL=https://billo-api-v30t.onrender.com
