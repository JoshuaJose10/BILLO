{
  "expo": {
    "name": "Billo",
    "slug": "billo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.billo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Billo usa el micrófono para registrar gastos con tu voz.",
          "speechRecognitionPermission": "Billo usa el reconocimiento de voz para convertir lo que dices en un gasto."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ResumenMes",
              "label": "Billo",
              "description": "Total del mes (prueba del spike HU-23)",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal"
            }
          ]
        }
      ]
    ]
  }
}
