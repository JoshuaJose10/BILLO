{
  "expo": {
    "name": "Billo",
    "slug": "billo",
    "scheme": "billo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.billo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#111114",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Billo usa el micrófono para registrar gastos con tu voz.",
          "speechRecognitionPermission": "Billo usa el reconocimiento de voz para convertir lo que dices en un gasto."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ResumenMes",
              "label": "Billo",
              "description": "Saldo del mes y accesos rápidos a gasto, ingreso y voz",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-resumen-preview.png"
            },
            {
              "name": "RegistrarVoz",
              "label": "Registrar por voz",
              "description": "Registra un gasto o ingreso hablando",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "previewImage": "./assets/widget-registrar-voz-preview.png"
            }
          ]
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "f61e8d44-9e9d-4283-b057-d9d5956b6f04"
      }
    },
    "owner": "joshua1020yts-team"
  }
}
